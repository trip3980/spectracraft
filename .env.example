# Optional SpectraCraft local web bridge configuration.
# Copy to `.env` if you need to override defaults locally; never commit `.env`.

# HTTP port and bind host for the Express + Vite bridge.
# Defaults to loopback 127.0.0.1 for safety (Audit H9). Pass `--host 0.0.0.0` or set
# SPECTRACRAFT_HOST=0.0.0.0 + SPECTRACRAFT_REMOTE_MODE=1 + SPECTRACRAFT_AUTH_TOKEN for remote access.
PORT=3000
# SPECTRACRAFT_HOST=127.0.0.1

# Remote / proxy security controls (Audit H9)
# SPECTRACRAFT_REMOTE_MODE=0
# SPECTRACRAFT_AUTH_TOKEN=
# SPECTRACRAFT_ADMIN_TOKEN=
# SPECTRACRAFT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# SPECTRACRAFT_TRUST_PROXY=0
# SPECTRACRAFT_ENABLE_DEV_UPDATES=0

# Optional override for temporary session storage and real disk quotas (Audit H10, M8)
# SPECTRACRAFT_SESSIONS_DIR=
# SPECTRACRAFT_MAX_SESSION_BYTES=268435456
# SPECTRACRAFT_MAX_TOTAL_SESSIONS_BYTES=1073741824

# Optional override for an external source-profile JSON catalog
# SPECTRAL_SOURCE_CATALOG_PATH=

# Optional environment variable checked by SpectraCraft Settings -> Integration (never committed)
# GEMINI_API_KEY=
