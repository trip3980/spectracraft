# Rust / Cargo build outputs
# Note: Cargo.lock IS tracked intentionally at the workspace root because
# SpectraCraft builds executable binaries (spectracraft-mono, spectracraft-qa,
# spectracraft-desktop) and uses --locked builds for reproducibility.
/target/
**/target/
**/*.rs.bk
*.pdb

# IDE & Editor files
.vscode/
.idea/
*.iml
*.ipr
*.iws
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Local audio media, session exports & scratch verification artifacts
*.wav
*.flac
*.aiff
*.mp3
*.spectracraft.json
ui-screens/
evidence/
spectracraft-sessions/
tmp/
.tmp/
*.tmp

# Logs, environment files, local ArtCraft user settings & secrets
*.log
.env
.env.*
!.env.example
config.toml
config.toml.bak
.spectracraft-config/

# Local web/preview harness artifacts (keep out of Rust repository commits)
node_modules/
dist/
build/
coverage/
bun.lock

# Tauri 2 build outputs, local installer outputs & generated mobile Xcode/Gradle scaffolds
src-tauri/target/
src-tauri/gen/
dist-installers/

# Local verification & AI Studio-only scratch directories
.aistudio/
.playwright-cli/
public/assets/aistudio/
